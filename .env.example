# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pesantren_keuangan?schema=public"

# Seed default (wajib diganti di production)
SEED_DEFAULT_PASSWORD="Pesantren#2026"

# Sesi API bertanda tangan HMAC (SERVER ONLY, minimal 32 karakter; buat dengan `openssl rand -hex 32`)
AUTH_SECRET=""

# Web3 custodial wallet (SERVER ONLY, jangan pakai prefix NEXT_PUBLIC_)
CUSTODIAL_MASTER_MNEMONIC="test test test test test test test test test test test junk"

# Jaringan & kontrak
RPC_URL="http://127.0.0.1:8545"
NEXT_PUBLIC_CHAIN_ID="31337"
PESANTREN_TREASURY_ADDRESS=""

# Backend signer (SERVER ONLY, wajib punya BENDAHARA_ROLE)
BENDAHARA_PRIVATE_KEY=""
WEB3_REQUEST_TIMEOUT_MS="7000"
WEB3_CONFIRM_TIMEOUT_MS="15000"
WEB3_MAX_ATTEMPTS="10"
WEB3_RETRY_BATCH_SIZE="10"

# Deployment Hardhat (gunakan akun terpisah dari backend signer)
SEPOLIA_RPC_URL=""
DEPLOYER_PRIVATE_KEY=""
ADMIN_YAYASAN_ADDRESS=""
BENDAHARA_ADDRESS=""
